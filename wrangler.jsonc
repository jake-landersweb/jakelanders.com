{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jake-site",
  "main": "worker.js",
  "compatibility_date": "2026-11-13",
  "workers_dev": false,
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "routes": [
    {
      "pattern": "jakelanders.com",
      "custom_domain": true
    },
    {
      "pattern": "www.jakelanders.com",
      "custom_domain": true
    }
  ]
}
